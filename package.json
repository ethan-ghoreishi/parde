{
  "name": "parde",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A private, local-first film and TV companion: collect, choose, track, schedule and reflect. No accounts, no keys, nothing leaves the device except metadata lookups.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^24.19.2",
    "@vite-pwa/assets-generator": "^1.0.4",
    "fake-indexeddb": "^6.2.8",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "dexie": "^4.4.7"
  },
  "overrides": {
    "workbox-build": {
      "glob": {
        ".": "14.0.2",
        "minimatch": "11.0.1"
      }
    }
  }
}
